# PostgreSQL接続（Vercel本番で必須・いずれか1つを設定）
# 優先順位: DATABASE_URL > POSTGRES_URL > STORAGE_URL > POSTGRES_URL_NON_POOLING > POSTGRES_PRISMA_URL
#
# Neon手動設定:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Vercel Postgres / Neon連携時（自動設定される場合あり）:
# POSTGRES_URL=
# STORAGE_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# ローカル開発（上記すべて未設定時のみSQLiteを使用）
# DATABASE_PATH=./data/tyu-sen.db

# 将来の拡張用
# X_API_BEARER_TOKEN=
# DISCORD_WEBHOOK_URL=
# LINE_NOTIFY_TOKEN=

# 定期巡回の有効化（本番環境で true に設定）
# ENABLE_CRON=true
