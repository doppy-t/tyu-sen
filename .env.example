# PostgreSQL接続（Vercel本番で必須）
# Neon / Vercel Postgres / Supabase いずれかの接続文字列を設定
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Vercel Postgres利用時は以下が自動設定されます
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# POSTGRES_URL_NON_POOLING=

# ローカル開発（DATABASE_URL未設定時のみSQLiteを使用）
# DATABASE_PATH=./data/tyu-sen.db

# 将来の拡張用
# X_API_BEARER_TOKEN=
# DISCORD_WEBHOOK_URL=
# LINE_NOTIFY_TOKEN=

# 定期巡回の有効化（本番環境で true に設定）
# ENABLE_CRON=true
